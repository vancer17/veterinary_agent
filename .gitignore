# =============================================================================
# 文件: .gitignore
# 作用: 定义仓库忽略规则，防止缓存、构建产物与真实密钥进入版本控制。
# 范围: 覆盖 Python、uv、Docker 本地环境、日志、测试缓存与本地数据文件。
# 说明: docker/*.env.template 与 docker/*/template/*.env.template 可提交审查，真实 *.env 仍由下方规则忽略。
# =============================================================================

# Python 字节缓存
__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# uv 虚拟环境与缓存
.venv/
.uv/
.vendor/
.ruff_cache/

# 环境变量、密钥
.env
.env.local
.env.dev
.env.prod
.env.production
*.env

# docker 目录用于提交可审查的容器编排、配置模板与挂载脚本；真实 *.env 仍被上一条规则忽略
!docker/
!docker/*.env.template
!docker/*/template/*.env.template

# 日志
*.log
logs/

# IDE 缓存
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 测试
.pytest_cache/
coverage/
.coverage
htmlcov/

# 数据库、缓存文件
.data/
*.db
*.sqlite
*.sqlite3

# 临时目录
tmp/
