# =============================================================================
# 文件: make/help.mk
# 作用: 输出 Make 工具链目标索引。
# 范围: 扫描根 Makefile 与 make/*.mk 中带有说明的目标。
# 说明: 目标说明统一写在 “target: ## 描述” 后，便于团队快速发现可用入口。
# =============================================================================

.PHONY: help

help: ## 输出可用 Make 目标索引。
	@printf "可用 Make 目标:\n"
	@awk 'BEGIN {FS = ":.*##"} /^[A-Za-z0-9_.-]+:.*##/ {printf "  %-34s %s\n", $$1, $$2}' $(MAKEFILE_LIST) | sort
