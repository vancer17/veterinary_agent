# =============================================================================
# 文件: docker/compose.prod.env.template
# 作用: 提供正式环境 Docker Compose 插值参数模板。
# 范围: 只包含项目名、中间件镜像、端口、worker 与日志滚动等编排层参数。
# 说明: 业务镜像版本由 GitHub Release tag 在 CD 中注入，不在本文件维护。
# =============================================================================

# Compose 项目名会影响生产容器、网络和卷名称。
COMPOSE_PROJECT_NAME=vet-agent-prod

# 共享 PostgreSQL 镜像。必须带 pgvector 扩展。
PGVECTOR_IMAGE=pgvector/pgvector:pg16

# PostgreSQL 容器共享内存大小；向量索引构建和相似度检索压力升高时可适当调大。
POSTGRES_SHM_SIZE=256mb

# PostgreSQL 健康检查间隔。
POSTGRES_HEALTHCHECK_INTERVAL=10s

# PostgreSQL 健康检查单次超时时间。
POSTGRES_HEALTHCHECK_TIMEOUT=5s

# PostgreSQL 健康检查重试次数。
POSTGRES_HEALTHCHECK_RETRIES=30

# LiteLLM Proxy 数据库版镜像；生产环境建议覆盖为固定版本 tag，避免回滚不可追溯。
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:main-stable

# Agent API 暴露给宿主机或负载均衡器的端口。
APP_PORT=8000

# Mem0 运维 Dashboard 仅建议绑定宿主机回环地址，并通过 SSH 隧道或内网入口访问。
MEM0_DASHBOARD_PORT=3001

# Agent app uvicorn worker 数。
APP_WORKERS=2

# LiteLLM worker 数。过高会增加上游模型与数据库压力。
LITELLM_WORKERS=2

# Docker json-file 单文件日志大小上限。
LOG_MAX_SIZE=20m

# Docker json-file 日志保留文件数。
LOG_MAX_FILE=5
