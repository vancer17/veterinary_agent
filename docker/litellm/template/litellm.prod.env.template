# =============================================================================
# 文件: docker/litellm/template/litellm.prod.env.template
# 作用: 提供正式环境 LiteLLM Proxy 运行时配置模板。
# 范围: 只描述 LiteLLM 元数据库、master key、Admin UI 登录、加密盐值与上游模型密钥变量结构。
# 说明: 正式环境真实密钥应写入 docker/litellm/template/litellm.prod.env，不进入版本控制。
# =============================================================================

# LiteLLM 元数据库连接串；用于持久化 virtual key、用户、团队、预算、用量记录和 UI 元数据。
DATABASE_URL=postgresql://litellm:<LITELLM_POSTGRES_PASSWORD>@postgres:5432/litellm

# LiteLLM Proxy 管理密钥；仅用于 Admin UI/API 和创建 virtual key，不应长期作为业务调用 key。
LITELLM_MASTER_KEY=

# LiteLLM 存储模型供应商凭据时使用的加密盐值；一旦写入数据库中的加密凭据存在，不应再更换。
LITELLM_SALT_KEY=

# LiteLLM Admin UI 登录用户名；用于访问 /ui 运维界面。
UI_USERNAME=

# LiteLLM Admin UI 登录密码；应使用强随机值并由生产密钥管理流程下发。
UI_PASSWORD=

# 通义千问 DashScope API Key；只注入 LiteLLM 容器，不应注入 Agent app。
DASHSCOPE_API_KEY=

# LiteLLM 对外 Web 根路径；当通过 Nginx 以 /litellm 子路径反代时必须显式配置。
SERVER_ROOT_PATH=/litellm

# LiteLLM 对外访问基准地址；应填写生产环境用户实际访问的公网地址。
PROXY_BASE_URL=https://example.com/litellm

# LiteLLM Admin UI 文档与接口基准地址；子路径反代场景需与 PROXY_BASE_URL 保持同源同前缀。
LITELLM_UI_API_DOC_BASE_URL=https://example.com/litellm
