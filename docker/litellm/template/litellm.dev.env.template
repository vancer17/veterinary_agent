# =============================================================================
# 文件: docker/litellm/template/litellm.dev.env.template
# 作用: 提供开发环境 LiteLLM Proxy 运行时配置模板。
# 范围: 面向开发环境真实 LiteLLM 到通义千问链路、Admin UI 登录与数据库凭据加密。
# 说明: 真实密钥应写入 docker/litellm/template/litellm.dev.env，不进入版本控制。
# =============================================================================

# LiteLLM 元数据库连接串；用于持久化 virtual key、用户、团队、预算、用量记录和 UI 元数据。
DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm

# LiteLLM Proxy 管理密钥；仅用于 Admin UI/API 和创建 virtual key，不应长期作为业务调用 key。
LITELLM_MASTER_KEY=sk-dev-litellm-change-me

# LiteLLM 存储模型供应商凭据时使用的加密盐值；一旦写入数据库中的加密凭据存在，不应再更换。
LITELLM_SALT_KEY=sk-dev-litellm-salt-change-me

# LiteLLM Admin UI 登录用户名；用于访问 /ui 运维界面。
UI_USERNAME=admin

# LiteLLM Admin UI 登录密码；开发环境也应在真实 env 中替换为本机专用值。
UI_PASSWORD=change-me-litellm-ui-password

# 通义千问 DashScope API Key；只注入 LiteLLM 容器，不应注入 Agent app。
DASHSCOPE_API_KEY=replace-with-real-dashscope-api-key

# LiteLLM 对外 Web 根路径；当通过 Nginx 以 /litellm 子路径反代时必须显式配置。
SERVER_ROOT_PATH=/litellm

# LiteLLM 对外访问基准地址；用于 Admin UI 生成接口请求、跳转地址和前端运行时配置。
PROXY_BASE_URL=http://127.0.0.1:4000/litellm

# LiteLLM Admin UI 文档与接口基准地址；子路径反代场景需与 PROXY_BASE_URL 保持同源同前缀。
LITELLM_UI_API_DOC_BASE_URL=http://127.0.0.1:4000/litellm
