# =============================================================================
# 文件: docker/opa/template/opa.dev.env.template
# 作用: 提供开发环境 OPA 策略服务敏感参数与官方配置替换变量模板。
# 范围: 默认只包含 OPA labels 所需环境标识；远程 bundle、status 与 decision log 凭据按需启用。
# 说明: 真实密钥应写入 docker/opa/template/opa.dev.env，不进入版本控制。
# =============================================================================

# OPA 官方配置 labels.environment 的替换值。
OPA_ENVIRONMENT=development

# OPA 官方配置 labels.instance 的替换值。
OPA_INSTANCE_ID=vet-agent-dev-opa

# 远程控制面 Bearer Token；仅在 application.yml 启用 services.control_plane.credentials.bearer 时需要。
OPA_CONTROL_PLANE_BEARER_TOKEN=

# bundle 签名公钥；仅在 application.yml 启用 bundles.*.signing 与 keys 时需要。
OPA_BUNDLE_SIGNING_PUBLIC_KEY=

# 服务版本标签；仅在 application.yml 启用 distributed_tracing.resource.service_version 时需要。
OPA_SERVICE_VERSION=dev
