# =============================================================================
# 文件: docker/app.prod.env.template
# 作用: 提供正式环境 Vet Agent API 运行时配置模板。
# 范围: 只描述应用容器运行所需变量结构；真实密钥与连接串由生产环境下发。
# 说明: 当前应用仍通过环境变量读取配置，后续可单独迁移非敏感项到 application.yml。
# =============================================================================

DATABASE_URL=postgresql://vet_agent:<POSTGRES_PASSWORD>@postgres:5432/vet_agent
# SQLAlchemy 主连接池大小；需结合 APP_WORKERS 与 PostgreSQL max_connections 统一规划。
DATABASE_POOL_SIZE=5
# SQLAlchemy 允许超过主连接池的临时连接数。
DATABASE_MAX_OVERFLOW=10
# 连接池获取连接的等待时间，单位秒。
DATABASE_POOL_TIMEOUT_SECONDS=30
# 连接回收时间，单位秒；用于规避长连接经过网络设备后的异常状态。
DATABASE_POOL_RECYCLE_SECONDS=1800
# 建立 PostgreSQL 连接的超时时间，单位秒。
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# 单条 SQL 最大执行时间，单位毫秒；0 表示不通过连接参数覆盖。
DATABASE_STATEMENT_TIMEOUT_MS=30000
# 空闲事务最大保留时间，单位毫秒；0 表示不通过连接参数覆盖。
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
# embedding 模型输出维度；需与 pgvector 字段、Mem0 collection 和 LiteLLM 模型路由保持一致。
QWEN_EMBEDDING_DIMENSION=1024
QWEN_VISION_MODEL=qwen-vl-plus
LITELLM_TIMEOUT_SECONDS=30
ENABLE_RAG_EMBEDDINGS=true
# LlamaIndex 通用 RAG 仅替换回答证据检索，不参与临床安全裁决。
LLAMAINDEX_RAG_SIMILARITY_TOP_K=4
LLAMAINDEX_RAG_MIN_SCORE=0.35
LLAMAINDEX_RAG_MAX_NODES=2000
LLAMAINDEX_RAG_INDEX_REFRESH_SECONDS=60
# 任务路由最大任务数；正式环境应与 OPA 策略及运行容量基线保持一致。
TASK_ROUTING_MAX_TASK_COUNT=5
# 任务路由 OPA 地址；正式 Compose 使用 opa 服务名，外部访问通过网关控制。
TASK_ROUTING_OPA_BASE_URL=http://opa:8181/v1
TASK_ROUTING_OPA_PACKAGE_PATH=vet_agent.task_routing
TASK_ROUTING_OPA_RULE_NAME=decision
TASK_ROUTING_OPA_AUTH_TOKEN=
ENABLE_MEMORY_EXTRACTION=true
ENABLE_LLM_MEMORY_EXTRACTION=true
# 后台任务最大重试次数；超过后进入 dead_letter，由运维或后续任务后台治理处理。
BACKGROUND_TASKS_MAX_ATTEMPTS=5
# 后台 worker 单轮最多领取任务数量；需结合模型网关并发、数据库连接池和实例数量配置。
BACKGROUND_TASKS_WORKER_BATCH_SIZE=4
# 后台 worker 任务租约秒数；worker 异常退出后，租约过期任务可被其他实例重新领取。
BACKGROUND_TASKS_WORKER_LEASE_SECONDS=300
# 后台 worker 空轮询间隔秒数；生产环境不宜过低，避免空队列时持续打扰数据库。
BACKGROUND_TASKS_WORKER_POLL_INTERVAL_SECONDS=2
ENABLE_MEM0=true
# 阶段迁移模式默认保持旧实现；生产灰度 LlamaIndex 通用 RAG 应先使用 shadow，再经回归后切换 enforced。
STRUCTURED_OUTPUT_MODE=legacy
POLICY_DECISION_MODE=legacy
KNOWLEDGE_RETRIEVAL_MODE=legacy
OUTPUT_GUARD_MODE=legacy
# 基础输入安全已迁移为候选采集加 OPA 裁决；生产环境必须保持 OPA 可用。
ENABLE_INPUT_SAFETY=true
INPUT_SAFETY_POLICY_BACKEND=opa
INPUT_SAFETY_POLICY_ALWAYS_CALL=true
INPUT_SAFETY_OPA_BASE_URL=http://opa:8181/v1
INPUT_SAFETY_OPA_PACKAGE_PATH=vet_agent.input_safety
INPUT_SAFETY_OPA_RULE_NAME=decision
INPUT_SAFETY_OPA_AUTH_TOKEN=
# 临床安全裁决必须调用 OPA；生产环境不得回退到本地动作规则。
CLINICAL_SAFETY_OPA_BASE_URL=http://opa:8181/v1
CLINICAL_SAFETY_OPA_PACKAGE_PATH=vet_agent.clinical_safety
CLINICAL_SAFETY_OPA_RULE_NAME=decision
CLINICAL_SAFETY_OPA_AUTH_TOKEN=
# Guardrails 提示注入检测默认关闭；上线前应先完成 shadow 观测与误判审查。
ENABLE_INPUT_SAFETY_GUARDRAILS=false
INPUT_SAFETY_GUARDRAILS_MODEL=openai/qwen-plus
INPUT_SAFETY_PROMPT_INJECTION_THRESHOLD=0.8
# 生产环境默认不启用 Guardrails；应先在 shadow 模式完成差异审查，再按发布流程切换 enforced。
OUTPUT_GUARD_BACKEND=legacy
MEM0_BASE_URL=http://mem0:8000
MEM0_API_KEY=
OSS_BUCKET=infra-prod-file-storage
OSS_PREFIX=
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
VET_AGENT_API_KEYS=
REQUIRE_API_AUTH=true
VET_AGENT_DATA_DIR=/app/.data
VET_AGENT_SEED_DIR=/app/assets/seeds
SEED_WITH_EMBEDDINGS=true
