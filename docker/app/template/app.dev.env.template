# =============================================================================
# 文件: docker/app.dev.env.template
# 作用: 提供开发环境 Vet Agent API 运行时配置模板。
# 范围: 面向本地开发链路，默认启用 PostgreSQL、LiteLLM、Mem0 与 RAG embedding。
# 说明: 本文件包含开发占位值；真实共享环境应复制为 docker/app/template/app.dev.env 后替换。
# =============================================================================

DATABASE_URL=postgresql://vet_agent:vet_agent@postgres:5432/vet_agent
# SQLAlchemy 主连接池大小；开发环境保持较小值，避免本机 PostgreSQL 连接过多。
DATABASE_POOL_SIZE=5
# SQLAlchemy 允许超过主连接池的临时连接数。
DATABASE_MAX_OVERFLOW=10
# 连接池获取连接的等待时间，单位秒。
DATABASE_POOL_TIMEOUT_SECONDS=30
# 连接回收时间，单位秒；用于规避长连接经过网络设备后的异常状态。
DATABASE_POOL_RECYCLE_SECONDS=1800
# 建立 PostgreSQL 连接的超时时间，单位秒。
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# 单条 SQL 最大执行时间，单位毫秒；0 表示不通过连接参数覆盖。
DATABASE_STATEMENT_TIMEOUT_MS=30000
# 空闲事务最大保留时间，单位毫秒；0 表示不通过连接参数覆盖。
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-dev-litellm-change-me
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
# embedding 模型输出维度；需与 pgvector 字段、Mem0 collection 和 LiteLLM 模型路由保持一致。
QWEN_EMBEDDING_DIMENSION=1024
QWEN_VISION_MODEL=qwen-vl-plus
LITELLM_TIMEOUT_SECONDS=30
ENABLE_RAG_EMBEDDINGS=true
# LlamaIndex 通用 RAG 仅替换回答证据检索，不参与临床安全裁决。
LLAMAINDEX_RAG_SIMILARITY_TOP_K=4
LLAMAINDEX_RAG_MIN_SCORE=0.35
LLAMAINDEX_RAG_MAX_NODES=2000
LLAMAINDEX_RAG_INDEX_REFRESH_SECONDS=60
ENABLE_LLM_TASK_SPLITTER=true
ENABLE_MEMORY_EXTRACTION=true
ENABLE_LLM_MEMORY_EXTRACTION=true
ENABLE_MEM0=true
# 阶段迁移模式默认保持旧实现；需要灰度 LlamaIndex 通用 RAG 时先将 KNOWLEDGE_RETRIEVAL_MODE 调整为 shadow。
STRUCTURED_OUTPUT_MODE=legacy
POLICY_DECISION_MODE=legacy
KNOWLEDGE_RETRIEVAL_MODE=legacy
OUTPUT_GUARD_MODE=legacy
# 输出审查后端默认保持旧实现；需要阶段 4 影子观测时同时设置 OUTPUT_GUARD_MODE=shadow 与 OUTPUT_GUARD_BACKEND=guardrails。
OUTPUT_GUARD_BACKEND=legacy
MEM0_BASE_URL=http://mem0:8000
MEM0_API_KEY=sk-dev-mem0-change-me
OSS_BUCKET=infra-dev-file-storage
OSS_PREFIX=
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
VET_AGENT_API_KEYS=
REQUIRE_API_AUTH=false
REQUIRE_AUTH_USER_MATCH=false
PET_AUTHORIZATION_MODE=permissive
SESSION_POLICY_MODE=permissive
VET_AGENT_DATA_DIR=/app/.data
VET_AGENT_SEED_DIR=/app/assets/seeds
VET_AGENT_CLINICAL_SAFETY_DIR=/app/assets/clinical_safety
SEED_WITH_EMBEDDINGS=true
