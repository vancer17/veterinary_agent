# =============================================================================
# 文件: docker/app/template/app.dev.env.template
# 作用: 提供开发环境 Vet Agent API 运行时配置模板。
# 范围: 面向本地开发链路，默认启用 PostgreSQL、LiteLLM、Mem0 与 RAG embedding。
# 说明: 本文件包含开发占位值；真实共享环境应复制为 docker/app/template/app.dev.env 后替换。
# =============================================================================

DATABASE_URL=postgresql://vet_agent:vet_agent@postgres:5432/vet_agent
# SQLAlchemy 主连接池大小；开发环境保持较小值，避免本机 PostgreSQL 连接过多。
DATABASE_POOL_SIZE=5
# SQLAlchemy 允许超过主连接池的临时连接数。
DATABASE_MAX_OVERFLOW=10
# 连接池获取连接的等待时间，单位秒。
DATABASE_POOL_TIMEOUT_SECONDS=30
# 连接回收时间，单位秒；用于规避长连接经过网络设备后的异常状态。
DATABASE_POOL_RECYCLE_SECONDS=1800
# 建立 PostgreSQL 连接的超时时间，单位秒。
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# 单条 SQL 最大执行时间，单位毫秒；0 表示不通过连接参数覆盖。
DATABASE_STATEMENT_TIMEOUT_MS=30000
# 空闲事务最大保留时间，单位毫秒；0 表示不通过连接参数覆盖。
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-dev-litellm-change-me
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
# embedding 模型输出维度；需与 pgvector 字段、Mem0 collection 和 LiteLLM 模型路由保持一致。
QWEN_EMBEDDING_DIMENSION=1024
QWEN_VISION_MODEL=qwen-vl-plus
LITELLM_TIMEOUT_SECONDS=30
# 强制 LiteLLM 使用包内本地模型成本表，避免应用导入阶段访问 GitHub Raw。
LITELLM_LOCAL_MODEL_COST_MAP=True
# NLTK tokenizer 数据放在 /opt 下，避免被开发环境 /app 源码挂载遮蔽。
NLTK_DATA=/opt/vet-agent/nltk_data
ENABLE_RAG_EMBEDDINGS=true
# LlamaIndex 通用 RAG 仅替换回答证据检索，不参与临床安全裁决。
LLAMAINDEX_RAG_SIMILARITY_TOP_K=4
LLAMAINDEX_RAG_MIN_SCORE=0.35
LLAMAINDEX_RAG_MAX_NODES=2000
LLAMAINDEX_RAG_INDEX_REFRESH_SECONDS=60
# 任务路由最大任务数；结构化输出、Pydantic 契约与 OPA 均使用该上限。
TASK_ROUTING_MAX_TASK_COUNT=5
# 任务路由 OPA 地址；开发 Compose 内网服务名为 opa。
TASK_ROUTING_OPA_BASE_URL=http://opa:8181/v1
TASK_ROUTING_OPA_PACKAGE_PATH=vet_agent.task_routing
TASK_ROUTING_OPA_RULE_NAME=decision
TASK_ROUTING_OPA_AUTH_TOKEN=
ENABLE_MEMORY_EXTRACTION=true
ENABLE_LLM_MEMORY_EXTRACTION=true
# 后台任务最大重试次数；开发环境保持与生产相同的状态语义，便于复现重试和死信问题。
BACKGROUND_TASKS_MAX_ATTEMPTS=5
# 后台 worker 单轮最多领取任务数量；本地资源有限时可适当调低。
BACKGROUND_TASKS_WORKER_BATCH_SIZE=4
# 后台 worker 任务租约秒数；worker 异常退出后，租约过期任务可被重新领取。
BACKGROUND_TASKS_WORKER_LEASE_SECONDS=300
# 后台 worker 空轮询间隔秒数；用于控制开发环境对 PostgreSQL 的空轮询压力。
BACKGROUND_TASKS_WORKER_POLL_INTERVAL_SECONDS=2
ENABLE_MEM0=true
# 阶段迁移模式默认保持旧实现；需要灰度 LlamaIndex 通用 RAG 时先将 KNOWLEDGE_RETRIEVAL_MODE 调整为 shadow。
STRUCTURED_OUTPUT_MODE=legacy
POLICY_DECISION_MODE=legacy
KNOWLEDGE_RETRIEVAL_MODE=legacy
# 基础输入安全已迁移为候选采集加 OPA 裁决；开发环境默认调用 compose 内网 OPA。
ENABLE_INPUT_SAFETY=true
INPUT_SAFETY_POLICY_BACKEND=opa
INPUT_SAFETY_POLICY_ALWAYS_CALL=true
INPUT_SAFETY_OPA_BASE_URL=http://opa:8181/v1
INPUT_SAFETY_OPA_PACKAGE_PATH=vet_agent.input_safety
INPUT_SAFETY_OPA_RULE_NAME=decision
# 临床安全裁决只消费 pgvector 候选和可信结构化语义；不得回退为 Python 硬编码规则。
CLINICAL_SAFETY_OPA_BASE_URL=http://opa:8181/v1
CLINICAL_SAFETY_OPA_PACKAGE_PATH=vet_agent.clinical_safety
CLINICAL_SAFETY_OPA_RULE_NAME=decision
# Guardrails 提示注入检测会额外调用模型，默认关闭；需要联调时显式开启并保证 LiteLLM 凭据可用。
ENABLE_INPUT_SAFETY_GUARDRAILS=false
INPUT_SAFETY_GUARDRAILS_MODEL=openai/qwen-plus
INPUT_SAFETY_PROMPT_INJECTION_THRESHOLD=0.8
MEM0_BASE_URL=http://mem0:8000
MEM0_API_KEY=sk-dev-mem0-change-me
VET_AGENT_IMAGE_VARIANT=core
OSS_BUCKET=infra-dev-file-storage
OSS_PREFIX=
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
VET_AGENT_API_KEYS=
REQUIRE_API_AUTH=false
VET_AGENT_DATA_DIR=/app/.data
VET_AGENT_SEED_DIR=/app/assets/seeds
# 默认 assets 已同步为已审核语料；开发环境需要候选态导入时可显式改为 pending。
CLINICAL_SAFETY_REVIEW_STATUS=approved
# 开发环境默认生成向量，便于本地复现部署后的 RAG 与临床安全召回链路。
SEED_WITH_EMBEDDINGS=true
# 输出安全在开发环境同样以 observe 模式运行，便于观察候选与策略元数据。
ENABLE_OUTPUT_SAFETY=true
OUTPUT_SAFETY_MODE=observe
OUTPUT_SAFETY_POLICY_BACKEND=local
OUTPUT_SAFETY_POLICY_ALWAYS_CALL=true
# Guardrails 输出增强仅在专项验证镜像中启用。
ENABLE_OUTPUT_SAFETY_GUARDRAILS=false
