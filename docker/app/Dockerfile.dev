# =============================================================================
# 文件: docker/app/Dockerfile.dev
# 作用: 基于 uv.lock 构建兽医 Agent 开发应用镜像。
# 范围: 面向本地开发与调试，不用于生产发布镜像。
# 说明: uv 依赖源由 pyproject.toml 与 UV_DEFAULT_INDEX 统一约束。
# =============================================================================

ARG PYTHON_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app/src

COPY pyproject.toml uv.lock README.md ./
COPY alembic.ini ./
COPY alembic ./alembic
COPY assets ./assets
COPY scripts ./scripts
COPY src ./src

RUN uv sync --frozen --no-dev

EXPOSE 8000

CMD ["uvicorn", "vet_agent.main:app", "--host", "0.0.0.0", "--port", "8000"]
