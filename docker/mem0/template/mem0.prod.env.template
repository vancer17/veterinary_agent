# =============================================================================
# 文件: docker/mem0/template/mem0.prod.env.template
# 作用: 提供正式环境 Mem0 REST Server 敏感参数模板。
# 范围: 仅保存 LiteLLM 访问密钥、Mem0 管理 key、JWT secret 与数据库密码。
# 说明: 正式环境真实密钥应写入 docker/mem0/template/mem0.prod.env，不进入版本控制。
# =============================================================================

# Mem0 通过 OpenAI 兼容协议访问 LiteLLM；应填写 Mem0 专用 LiteLLM virtual key。
OPENAI_API_KEY=

# Mem0 legacy 管理 API key；Agent 侧 MEM0_API_KEY 应与此值一致。
ADMIN_API_KEY=

# Mem0 Dashboard/JWT 鉴权密钥；生产环境必须使用强随机值。
JWT_SECRET=

# Mem0 访问 PostgreSQL 逻辑库的密码；用户名和库名位于 application.yml。
POSTGRES_PASSWORD=
