# =============================================================================
# 文件: docker/mem0.prod.env.template
# 作用: 提供正式环境 Mem0 REST Server 运行时配置模板。
# 范围: 只描述 Mem0 模型代理、鉴权、PostgreSQL 与 collection 变量结构。
# 说明: 正式环境真实密钥应写入 docker/mem0/template/mem0.prod.env，不进入版本控制。
# =============================================================================

OPENAI_API_KEY=
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_BASE=http://litellm:4000/v1
MEM0_DEFAULT_LLM_MODEL=qwen-plus
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-v4
MEM0_EMBEDDING_MODEL_DIMS=1024
ADMIN_API_KEY=
JWT_SECRET=
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
MEM0_TELEMETRY=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mem0_vector
POSTGRES_USER=mem0
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=vet_agent_memories
APP_DB_NAME=mem0_app
