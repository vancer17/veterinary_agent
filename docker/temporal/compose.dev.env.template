# =============================================================================
# 文件: docker/temporal/compose.dev.env.template
# 作用: 提供远端开发环境 Temporal Compose 参数模板。
# 范围: Compose 项目、镜像版本、端口绑定、既有 PostgreSQL 凭据和逻辑库。
# 说明: 复制为 compose.dev.env 后填写真实值；compose.dev.env 不应提交。
# =============================================================================

# Compose 项目名。使用独立项目，避免影响 vet-agent-dev 主项目。
COMPOSE_PROJECT_NAME=vet-agent-dev-temporal

# Temporal Server 版本。开发环境固定版本，不使用 latest。
TEMPORAL_IMAGE=temporalio/auto-setup:1.29.1

# Temporal Web UI 版本。
TEMPORAL_UI_IMAGE=temporalio/ui:2.34.0

# Temporal admin tools 版本。
TEMPORAL_ADMIN_TOOLS_IMAGE=temporalio/admin-tools:1.29.1-tctl-1.18.4-cli-1.5.0

# 复用现有 vet-agent-dev-postgres 容器所在 Docker 网络。
TEMPORAL_NETWORK_NAME=vet-agent-dev_default

# 共享 PostgreSQL 在该网络内的主机名。当前远端环境使用稳定容器名。
TEMPORAL_POSTGRES_HOST=vet-agent-dev-postgres

# Temporal 专用登录角色和逻辑库；与 Agent、LiteLLM、Mem0 业务库隔离。
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility

# 必须替换；建议使用 openssl rand -hex 24 生成。
TEMPORAL_POSTGRES_PASSWORD=change-me

# Frontend 默认只绑定远端本机，本地通过 SSH tunnel 访问。
TEMPORAL_FRONTEND_BIND=127.0.0.1
TEMPORAL_FRONTEND_PORT=7233

# UI 默认只绑定远端本机，本地通过 SSH tunnel 访问。
TEMPORAL_UI_BIND=127.0.0.1
TEMPORAL_UI_PORT=8080

# 受限语义协作 DAG 集成测试使用的 namespace。
TEMPORAL_NAMESPACE=semantic-collaboration-dev
