# =============================================================================
# 文件: docker/postgres.prod.env.template
# 作用: 提供正式环境 PostgreSQL 容器运行时配置模板。
# 范围: 初始化 Agent、LiteLLM、Mem0 相关逻辑库和最小权限账号。
# 说明: 正式环境真实密码应写入 docker/postgres/template/postgres.prod.env，不进入版本控制。
# =============================================================================

POSTGRES_DB=postgres
POSTGRES_USER=postgres
