# =============================================================================
# 文件: docker/postgres.prod.env.template
# 作用: 提供正式环境 PostgreSQL 容器运行时配置模板。
# 范围: 初始化 Agent、LiteLLM、Mem0 相关逻辑库和最小权限账号。
# 说明: 正式环境真实密码应写入 docker/postgres/template/postgres.prod.env，不进入版本控制。
# =============================================================================

# 初始化连接使用的默认管理库；通常保持 postgres。
POSTGRES_DB=postgres

# 初始化阶段使用的管理员账号；负责创建业务逻辑库、角色和扩展。
POSTGRES_USER=postgres

# 正式环境管理员密码；必须写入未入库的 postgres.prod.env。
POSTGRES_PASSWORD=

# Agent 业务逻辑库；存放业务表、RAG chunk、临床安全向量与治理记录。
VET_AGENT_POSTGRES_DB=vet_agent

# Agent 业务库最小权限账号。
VET_AGENT_POSTGRES_USER=vet_agent

# Agent 业务库正式密码；必须写入未入库的 postgres.prod.env。
VET_AGENT_POSTGRES_PASSWORD=

# LiteLLM 元数据库；存放 virtual key、用户、团队、预算和用量记录。
LITELLM_POSTGRES_DB=litellm

# LiteLLM 元数据库账号。
LITELLM_POSTGRES_USER=litellm

# LiteLLM 元数据库正式密码；必须写入未入库的 postgres.prod.env。
LITELLM_POSTGRES_PASSWORD=

# Mem0 向量库；存放语义记忆 pgvector collection。
MEM0_POSTGRES_DB=mem0_vector

# Mem0 共享数据库账号；同时拥有向量库和应用库。
MEM0_POSTGRES_USER=mem0

# Mem0 数据库正式密码；必须写入未入库的 postgres.prod.env。
MEM0_POSTGRES_PASSWORD=

# Mem0 应用库；存放用户、API key、请求日志等非向量运行数据。
MEM0_APP_DB_NAME=mem0_app
