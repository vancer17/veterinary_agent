# =============================================================================
# 文件: docker/compose.dev.env.template
# 作用: 提供开发环境 Docker Compose 插值参数模板。
# 范围: 只包含项目名、镜像基线、宿主机端口和 worker 数等编排层参数。
# 说明: 真实本地覆盖值可写入 docker/compose.dev.env，该文件不应提交。
# =============================================================================

# Compose 项目名会影响容器、网络和卷的命名前缀。
COMPOSE_PROJECT_NAME=vet-agent-dev

# Python 基础镜像，仅用于开发环境构建 Agent app 镜像。
PYTHON_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm

# 共享 PostgreSQL 镜像。必须带 pgvector 扩展。
PGVECTOR_IMAGE=pgvector/pgvector:pg16

# PostgreSQL 容器共享内存大小；HNSW 索引、排序和并发查询会受该值影响。
POSTGRES_SHM_SIZE=256mb

# PostgreSQL 健康检查间隔。
POSTGRES_HEALTHCHECK_INTERVAL=5s

# PostgreSQL 健康检查单次超时时间。
POSTGRES_HEALTHCHECK_TIMEOUT=5s

# PostgreSQL 健康检查重试次数。
POSTGRES_HEALTHCHECK_RETRIES=20

# LiteLLM Proxy 数据库版镜像；固定到已验证支持 DashScope embedding 的版本，避免漂移标签引入行为变化。
LITELLM_IMAGE=ghcr.io/berriai/litellm-database:1.96.0

# Mem0 Python 基础镜像，仅用于开发环境构建自托管 Mem0 服务镜像。
MEM0_PYTHON_BASE_IMAGE=python:3.12-slim-bookworm

# Mem0 Dashboard Node.js 基础镜像，仅用于开发环境构建运维 Dashboard 镜像。
MEM0_DASHBOARD_NODE_BASE_IMAGE=node:20-bookworm-slim

# Agent API 暴露给宿主机的端口。
APP_PORT=8000

# 开发调试用 PostgreSQL 宿主机端口。
POSTGRES_PORT=5432

# 开发调试用 LiteLLM 宿主机端口。
LITELLM_PORT=4000

# 开发调试用 Mem0 宿主机端口。
MEM0_PORT=8001

# 开发调试用 Mem0 运维 Dashboard 宿主机端口。
MEM0_DASHBOARD_PORT=3001

# LiteLLM worker 数。开发环境保持较小值，避免本机资源占用过高。
LITELLM_WORKERS=2
